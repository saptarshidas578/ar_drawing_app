# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files that must have LF line endings
*.kt text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.gradle text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Gradle wrapper script on Windows needs CRLF or standard line endings, while Unix script must be LF
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.so binary
*.aar binary
*.apk binary
*.aab binary
